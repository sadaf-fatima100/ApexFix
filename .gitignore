# ApexFix - Production Git Ignore Policy

# Root-level temporary screenshots and test captures
/*.png
/*.jpg
/*.jpeg
/*.webp
!/assets/**

# Environment & Security Sensitive Files
.env
.env.*
*.pem
*.key
*.cert
*.p12

# Logs and runtime data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies and caches
node_modules/
__pycache__/
*.py[cod]

# Editor & IDE files
.vscode/
.idea/
.agent/
*.swp
*.swo

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backups and temporary test data
*.backup
*.bak
*.tmp
scratch/
scratch_*.json
test_*.html
